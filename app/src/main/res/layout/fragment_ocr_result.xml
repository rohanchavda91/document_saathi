<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top App Bar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:background="@color/primary"
        android:elevation="@dimen/app_bar_elevation">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Extracted Text"
            android:textAppearance="@style/TextAppearance.HeadlineSmall"
            android:textColor="@color/on_primary" />

    </androidx.appcompat.widget.Toolbar>

    <!-- Main Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/padding_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Extracted Text Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_lg">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Extracted Content"
                    android:textAppearance="@style/TextAppearance.TitleMedium"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="@dimen/spacing_md" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/corner_radius_lg"
                    app:cardElevation="@dimen/card_elevation_default"
                    app:cardBackgroundColor="@color/primary_light">

                    <TextView
                        android:id="@+id/tvExtractedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No text extracted"
                        android:textAppearance="@style/TextAppearance.BodyMedium"
                        android:textColor="@color/on_surface"
                        android:padding="@dimen/padding_card"
                        android:lineSpacingMultiplier="1.6" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- AI Summary Section -->
            <LinearLayout
                android:id="@+id/summarySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_xl"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AI Summary"
                    android:textAppearance="@style/TextAppearance.TitleMedium"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="@dimen/spacing_md" />

                <!-- Language Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:spacing="@dimen/spacing_md"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Language"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <Spinner
                            android:id="@+id/spinnerSummaryLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height"
                            android:padding="@dimen/padding_button" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnSummarize"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/button_height"
                        android:layout_weight="0.5"
                        android:text="Generate"
                        android:textAppearance="@style/TextAppearance.LabelLarge"
                        android:textColor="@color/on_primary"
                        android:background="@drawable/bg_button_success"
                        style="@style/Widget.Button.Success" />

                </LinearLayout>

                <!-- Summary Display -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="@dimen/corner_radius_lg"
                    app:cardElevation="@dimen/card_elevation_default"
                    app:cardBackgroundColor="@color/primary_light"
                    android:layout_marginBottom="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_card">

                        <TextView
                            android:id="@+id/tvSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Select a language and tap 'Generate' to create an AI summary"
                            android:textAppearance="@style/TextAppearance.BodyMedium"
                            android:textColor="@color/on_surface"
                            android:lineSpacingMultiplier="1.6"
                            android:layout_marginBottom="@dimen/spacing_md" />

                        <ProgressBar
                            android:id="@+id/progressSummarization"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvSummaryLanguage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Summary Language"
                            android:textAppearance="@style/TextAppearance.LabelSmall"
                            android:textColor="@color/primary"
                            android:visibility="gone" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_horizontal"
        android:paddingBottom="@dimen/spacing_lg">

        <!-- Horizontal Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:spacing="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_md">

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="Copy"
                android:textAppearance="@style/TextAppearance.LabelLarge"
                android:textColor="@color/on_primary"
                android:background="@drawable/bg_capture_button"
                style="@style/Widget.Button.Primary" />

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="Share"
                android:textAppearance="@style/TextAppearance.LabelLarge"
                android:textColor="@color/on_primary"
                android:background="@drawable/bg_button_success"
                style="@style/Widget.Button.Success" />

        </LinearLayout>

        <!-- Back to Home Button -->
        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:text="Back to Home"
            android:textAppearance="@style/TextAppearance.LabelLarge"
            android:textColor="@color/primary"
            android:background="@drawable/bg_button_secondary"
            style="@style/Widget.Button.Secondary" />

    </LinearLayout>

</LinearLayout>